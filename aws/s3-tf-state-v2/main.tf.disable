resource "aws_dynamodb_table" "dynamodb_table" {
  name         = lower("${var.project}-${var.team}-${var.environment}-tf-state-lock")
  hash_key     = "LockID"
  billing_mode = "PAY_PER_REQUEST"
  attribute {
    name = "LockID"
    type = "S"
  }
}

