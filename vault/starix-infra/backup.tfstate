        {
          "schema_version": 0,
          "attributes": {
            "id": "transit/admin",
            "name": "transit/admin",
            "namespace": null,
            "policy": "\n# Enable transit secrets engine\npath \"sys/mounts/transit\" {\n  capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n}\n\n# To read enabled secrets engines\npath \"sys/mounts\" {\n  capabilities = [ \"read\" ]\n}\n\n# Manage the transit secrets engine\npath \"transit/*\" {\n  capabilities = [ \"create\", \"read\", \"update\", \"delete\", \"list\" ]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "vault_mount.transit"
          ]
        }
