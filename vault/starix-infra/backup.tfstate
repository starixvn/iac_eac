    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "pipeline",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "gitlab-aws-ci",
            "name": "gitlab-aws-ci",
            "namespace": null,
            "policy": "# Allow to read AWS secrets\npath \"aws_dev/sts/vault-aws-assumed-role\" {\n  capabilities = [\"read\", \"update\", \"create\"]\n}\n\n# Allow to manage authentification into the Vault with AWS auth method\npath \"auth/aws_dev/*\" {\n  capabilities = [\"read\", \"update\", \"create\", \"delete\", \"list\"]\n}\n\n# Allow pipeline to create a Vault child token when using Terraform\npath \"auth/token/create\" {\n  capabilities = [\"update\"]\n}\n"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "data.vault_policy_document.pipeline_aws_read",
            "vault_auth_backend.aws",
            "vault_aws_secret_backend.aws",
            "vault_aws_secret_backend_role.pipeline"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "pki_team_policy",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "global/pki-team",
            "name": "global/pki-team",
            "namespace": null,
            "policy": "\n## PKI Secret Engine\n# Work with pki secrets engine\npath \"pki/*\" {\n  capabilities = [ \"read\", \"list\"]\n}\n\n### Server certifiate\npath \"pki/issue/server-certificates\" {\n  capabilities = [ \"create\", \"update\", \"read\", \"list\"]\n}\n\n### Server certifiate\npath \"pki/issue/client-certificates\" {\n  capabilities = [ \"create\", \"update\", \"read\", \"list\"]\n}\n\n# Work with pki secrets engine\npath \"ecpki/*\" {\n  capabilities = [ \"read\", \"list\"]\n}\n\n### Server certifiate\npath \"ecpki/issue/ec-server-certificates\" {\n  capabilities = [ \"create\", \"update\", \"read\", \"list\"]\n}\n\n### Server certifiate\npath \"ecpki/issue/ec-client-certificates\" {\n  capabilities = [ \"create\", \"update\", \"read\", \"list\"]\n}"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
