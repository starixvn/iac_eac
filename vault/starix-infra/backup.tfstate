            "name": "global/pontus-policy-admin",
            "namespace": null,
            "policy": "path \"sys/policies/acl/*\" {\n  capabilities = [\"list\"]\n}\n\npath \"sys/policies/acl/p-mssql-*\" {\n  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\"]\n}\npath \"sys/policies/acl/p-mysql-*\" {\n  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\"]\n}\n"
          },
          "sensitive_attributes": [],
