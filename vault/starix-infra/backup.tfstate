    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "automated-token-renew",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "global/automated-token-renew",
            "name": "global/automated-token-renew",
            "namespace": null,
            "policy": "\n## Allow tokens to look up their own properties\n## for vault cli login\npath \"auth/token/lookup-self\" {\n    capabilities = [\"read\"]\n}\n\n\n## Allow list of accessors token\npath \"/auth/token/accessors\" {\n  capabilities = [ \"read\", \"list\"]\n}\n\n## Allow accessor tokens lookup \npath \"/auth/token/lookup-accessor\" {\n  capabilities = [ \"read\", \"update\"]\n}\n\n\n## Allow renew of accessors token \n\npath \"/auth/token/renew-accessor\" {\n  capabilities = [ \"read\", \"update\"]\n}"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "backup_policy",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "global/backup",
            "name": "global/backup",
            "namespace": null,
            "policy": "## Allow to take snaptshot for backups\n\npath \"/sys/storage/raft/snapshot\" {\n  capabilities = [\"create\", \"read\"]\n}\n\npath \"/sys/storage/raft/configuration\" {\n  capabilities = [\"read\"]\n}"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
    {
      "mode": "managed",
      "type": "vault_policy",
      "name": "global-pontus-policy-admin",
      "provider": "provider[\"registry.terraform.io/hashicorp/vault\"]",
