        {
          "schema_version": 0,
          "attributes": {
            "hcl": "# Allow to read AWS secrets\npath \"aws_dev/sts/vault-aws-assumed-role\" {\n  capabilities = [\"read\", \"update\", \"create\"]\n}\n\n# Allow to manage authentification into the Vault with AWS auth method\npath \"auth/aws_dev/*\" {\n  capabilities = [\"read\", \"update\", \"create\", \"delete\", \"list\"]\n}\n\n# Allow pipeline to create a Vault child token when using Terraform\npath \"auth/token/create\" {\n  capabilities = [\"update\"]\n}\n",
            "id": "1034577867",
            "namespace": null,
            "rule": [
              {
                "allowed_parameter": [],
                "capabilities": [
                  "read",
                  "update",
                  "create"
                ],
                "denied_parameter": [],
                "description": "Allow to read AWS secrets",
                "max_wrapping_ttl": "",
                "min_wrapping_ttl": "",
                "path": "aws_dev/sts/vault-aws-assumed-role",
                "required_parameters": []
              },
              {
                "allowed_parameter": [],
                "capabilities": [
                  "read",
                  "update",
                  "create",
                  "delete",
                  "list"
                ],
                "denied_parameter": [],
                "description": "Allow to manage authentification into the Vault with AWS auth method",
                "max_wrapping_ttl": "",
                "min_wrapping_ttl": "",
                "path": "auth/aws_dev/*",
                "required_parameters": []
              },
              {
                "allowed_parameter": [],
                "capabilities": [
                  "update"
                ],
                "denied_parameter": [],
                "description": "Allow pipeline to create a Vault child token when using Terraform",
                "max_wrapping_ttl": "",
                "min_wrapping_ttl": "",
                "path": "auth/token/create",
                "required_parameters": []
